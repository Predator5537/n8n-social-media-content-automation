      "parameters": {
        "jsCode": "\nconst now = new Date();\nconst twoHoursAgo = new Date(now.getTime() - 2 * 60 * 60 * 1000);\nconst stuck = $input.all().filter(item => {\n  const status = (item.json['Status'] || '').toString().trim().toUpperCase();\n  if (status !== 'DRAFTGENERATING') return false;\n  const lu = item.json['Last Updated At'];\n  if (!lu) return true;\n  return new Date(lu) < twoHoursAgo;\n});\nif (stuck.length === 0) {\n  return [{ json: { _recovery_needed: false } }];\n}\nreturn stuck.map(r => ({ json: { ...r.json, _recovery_needed: true } }));\n",
        "mode": "runOnceForAllItems"
