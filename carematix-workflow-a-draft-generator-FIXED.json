    {
      "id": "node_25",
      "name": "Track Failure — API",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5260,
        780
      ],
      "parameters": {
        "jsCode": "\nconst s = $getWorkflowStaticData('global');\ns.failure_count = (s.failure_count || 0) + 1;\ns.failed_row_ids = s.failed_row_ids || [];\ns.failed_row_ids.push($json['Row ID'] || $json._original?.['Row ID'] || 'unknown');\nreturn {json: $json};\n",
        "mode": "runOnceForEachItem"
      }
    },
    {
      "id": "node_26",
      "name": "Parse Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4220,
        300
      ],
      "parameters": {
        "jsCode": "\nconst row = $json;\nconst rawText = row._ai_text || '';\n// Strip markdown code fences\nlet cleaned = rawText.replace(/```json\\s*/gi, '').replace(/```\\s*/gi, '').trim();\n// Extract first JSON block\nconst jsonMatch = cleaned.match(/\\{[\\s\\S]*\\}/);\nif (!jsonMatch) {\n  return {json: {...row, _parse_ok: false, _raw_ai: rawText.substring(0,2000), _parse_error: 'No JSON block found'}};\n}\nlet parsed;\ntry {\n  parsed = JSON.parse(jsonMatch[0]);\n} catch(e) {\n  return {json: {...row, _parse_ok: false, _raw_ai: rawText.substring(0,2000), _parse_error: 'JSON.parse failed: ' + e.message}};\n}\nconst required = ['linkedin_draft','facebook_draft','instagram_caption','image_brief','suggested_cta'];\nconst missing = required.filter(k => !parsed[k] || parsed[k].toString().trim() === '');\nif (missing.length > 0) {\n  return {json: {...row, _parse_ok: false, _raw_ai: rawText.substring(0,2000), _parse_error: 'Missing fields: ' + missing.join(', ')}};\n}\nreturn {json: {...row, _parsed: parsed, _parse_ok: true, _raw_ai: rawText.substring(0,2000)}};\n",
        "mode": "runOnceForEachItem"
      }
    },
    {
      "id": "node_27",
      "name": "IF Parse OK",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        4480,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "combinator": "and"
          },
          "conditions": [
