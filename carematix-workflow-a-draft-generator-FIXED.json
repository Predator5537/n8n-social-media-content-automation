      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2140,
        520
      ],
      "parameters": {
        "jsCode": "\nconst row = $json;\nconst required = ['Product Education','Content Pillar','Objective','Audience','CTA'];\nconst missing = required.filter(f => !row[f] || String(row[f]).trim() === '');\nif (missing.length > 0) {\n  return {json: {...row, _valid: false, _missing: missing.join(', ')}};\n}\nreturn {json: {...row, _valid: true}};\n",
        "mode": "runOnceForEachItem"
      }
    },
