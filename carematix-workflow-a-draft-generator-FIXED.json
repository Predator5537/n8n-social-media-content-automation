              }
            }
          ]
        }
      }
    },
    {
      "id": "node_23",
      "name": "Handle API Failure",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4740,
        780
      ],
      "parameters": {
        "jsCode": "\nconst row = $json;\nreturn {json: {\n  'Row ID': row['Row ID'],\n  'Status': 'FAILEDGENERATION',\n  'Error Code': 'APIFAILURE',\n  'Review Notes': 'AI call failed — no response. Gemini: ' + (row._raw_gemini || 'N/A').substring(0,500) + ' | OpenRouter: ' + (row._raw_openrouter || 'N/A').substring(0,500),\n  'Last Updated At': new Date().toISOString(),\n  'Retry Count': (parseInt(row['Retry Count']) || 0) + 1,\n  _original: row\n}};\n",
        "mode": "runOnceForEachItem"
      }
    },
    {
      "id": "node_24",
      "name": "Update API Failure",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        5000,
        780
      ],
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "value": "1djoz4p-YyJ4Pu43-f9dUjWu4VhY6BCt-uUVMVVdK620",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Content Queue",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Row ID": "={{ $json[\"Row ID\"] }}",
            "Status": "={{ $json.Status }}",
            "Error Code": "={{ $json[\"Error Code\"] }}",
            "Review Notes": "={{ $json[\"Review Notes\"] }}",
            "Last Updated At": "={{ $json[\"Last Updated At\"] }}",
            "Retry Count": "={{ $json[\"Retry Count\"] }}"
          },
          "matchingColumns": [
            "Row ID"
          ]
        }
      },
      "credentials": {
