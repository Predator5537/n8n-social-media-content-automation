    {
      "id": "node_6",
      "name": "Filter Eligible Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1080,
        400
      ],
      "parameters": {
        "jsCode": "\nconst now = new Date();\nconst in14 = new Date(now.getTime() + 14*24*60*60*1000);\nconst config = $('Set Config Variables').first().json;\nconst rows = $input.all().filter(item => {\n  const s = (item.json['Status'] || '').toString().trim().toUpperCase();\n  if (s !== 'BRIEFREADY') return false;\n  const pd = item.json['Publish Date'];\n  if (!pd) return false;\n  const d = new Date(pd);\n  return d >= now && d <= in14;\n});\nif (rows.length === 0) {\n  return [{json: { _no_rows: true, ...config }}];\n}\nreturn rows.map(r => ({json: { ...r.json, _no_rows: false, _config: config }}));\n",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "node_7",
      "name": "IF No Eligible Rows",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
