# ─── Carematix n8n Workflow — Environment Variables ──────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git.

# Google Gemini API Key
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key (fallback AI)
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google OAuth (set via n8n Credentials UI — not stored here)
# Client ID and Client Secret are entered directly into n8n.
# See GOOGLE-SHEETS-OAUTH-SETUP.md for instructions.
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
