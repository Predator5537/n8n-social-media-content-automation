        "jsCode": "\nconst rows = $input.first().json.approved;\nconst valid   = rows.filter(r => r['Reviewer'] && r['Approval Date']);\nconst invalid = rows.filter(r => !(r['Reviewer'] && r['Approval Date']));\nreturn [{json:{valid, invalid, hasInvalid: invalid.length > 0}}];\n",
        "mode": "runOnceForAllItems"
