    {
      "parameters": {
        "jsCode": "\nconst normalize = s => (s||'').toString().trim().toUpperCase().replace(/[\\s_-]/g,'');\nconst rows = $input.all().map(r => r.json);\n\nconst draftReady = rows.filter(r => normalize(r['Status']) === 'DRAFTREADY');\nconst approved   = rows.filter(r => normalize(r['Status']) === 'APPROVED');\nconst rejected   = rows.filter(r => normalize(r['Status']) === 'REJECTED');\n\nreturn [{json: {\n  draftReady, approved, rejected,\n  hasDraftReady: draftReady.length > 0,\n  hasApproved  : approved.length   > 0,\n  hasRejected  : rejected.length   > 0\n}}];\n",
        "mode": "runOnceForAllItems"
      },
      "id": "wfb-003",
      "name": "Classify Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        400
      ]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "id": "d1",
              "leftValue": "={{ $json.hasDraftReady }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "wfb-004",
      "name": "IF \u2014 Draft Ready?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        780,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.first().json.draftReady;\nconst sheetUrl = 'https://docs.google.com/spreadsheets/d/1djoz4p-YyJ4Pu43-f9dUjWu4VhY6BCt-uUVMVVdK620/edit?gid=141580119';\n\nconst esc = s => String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\nconst nl2br = s => esc(s).replace(/\\n/g,'<br>');\n\nlet cardsHtml = '';\nfor (const row of rows) {\n  cardsHtml += `\n    <div style=\"border:1px solid #e0e0e0;border-radius:10px;padding:22px;margin-bottom:24px;background:#fff;\">\n      <h3 style=\"margin:0 0 4px 0;font-size:15px;color:#1d1c84;\">${esc(row['Row ID'])} &mdash; ${esc(row['Product Education']||row['Theme']||'')}</h3>\n      <p style=\"margin:0 0 16px 0;font-size:12px;color:#888;\">\n        <strong>Pillar:</strong> ${esc(row['Content Pillar'])} &nbsp;&bull;&nbsp;\n        <strong>Audience:</strong> ${esc(row['Audience'])} &nbsp;&bull;&nbsp;\n        <strong>Publish:</strong> ${esc(row['Publish Date'])}\n      </p>\n      <div style=\"background:#f0f4ff;border-left:4px solid #0077b5;padding:12px 14px;margin-bottom:10px;border-radius:0 6px 6px 0;\">\n        <div style=\"font-weight:bold;color:#0077b5;font-size:12px;margin-bottom:6px;\">&#128188; LINKEDIN</div>\n        <div style=\"font-size:13px;line-height:1.7;color:#1a1a1a;\">${nl2br(row['LinkedIn Draft']||'(not generated)')}</div>\n      </div>\n      <div style=\"background:#f0f4ff;border-left:4px solid #1877f2;padding:12px 14px;margin-bottom:10px;border-radius:0 6px 6px 0;\">\n        <div style=\"font-weight:bold;color:#1877f2;font-size:12px;margin-bottom:6px;\">&#128216; FACEBOOK</div>\n        <div style=\"font-size:13px;line-height:1.7;color:#1a1a1a;\">${nl2br(row['Facebook Draft']||'(not generated)')}</div>\n      </div>\n      <div style=\"background:#fff0f5;border-left:4px solid #e1306c;padding:12px 14px;margin-bottom:10px;border-radius:0 6px 6px 0;\">\n        <div style=\"font-weight:bold;color:#e1306c;font-size:12px;margin-bottom:6px;\">&#128248; INSTAGRAM</div>\n        <div style=\"font-size:13px;line-height:1.7;color:#1a1a1a;\">${nl2br(row['Instagram Caption']||'(not generated)')}</div>\n      </div>\n      <div style=\"background:#fffbea;border:1px solid #f5d040;border-radius:6px;padding:10px 14px;margin-bottom:10px;font-size:12px;color:#555;\">\n        <strong>&#127912; Image Brief:</strong> ${esc(row['Image Brief']||'(none)')}<br>\n        <strong>&#128279; CTA:</strong> ${esc(row['CTA']||'(none)')}\n      </div>\n      <div style=\"background:#f8f8f8;border-radius:6px;padding:10px 14px;font-size:12px;color:#444;line-height:1.9;\">\n        <strong>Review actions:</strong><br>\n        &#9989; <strong>Approve:</strong> Set Status = <code style=\"background:#e6ffe6;padding:1px 5px;border-radius:3px;\">APPROVED</code> &mdash; fill <em>Reviewer</em> + <em>Approval Date</em><br>\n        &#10060; <strong>Reject:</strong> Set Status = <code style=\"background:#ffe6e6;padding:1px 5px;border-radius:3px;\">REJECTED</code> &mdash; fill <em>Rejection Reason</em>\n      </div>\n    </div>`;\n}\n\nconst html = `<!DOCTYPE html><html><body style=\"font-family:Arial,Helvetica,sans-serif;background:#f4f4f7;margin:0;padding:24px;\">\n  <div style=\"max-width:680px;margin:0 auto;\">\n    <div style=\"background:#1d1c84;border-radius:10px 10px 0 0;padding:20px 28px;\">\n      <h2 style=\"color:#fff;margin:0;font-size:18px;\">&#128221; ${rows.length} Draft(s) Ready for Review</h2>\n      <p style=\"color:#b0b8ff;margin:4px 0 0 0;font-size:12px;\">Carematix Content Queue &mdash; Weekly Review</p>\n    </div>\n    <div style=\"background:#f9f9fb;padding:24px 28px;border:1px solid #e0e0e0;border-top:none;\">\n      <p style=\"color:#666;font-size:13px;margin:0 0 20px 0;\">\n        Review each draft below. Open the <a href=\"${sheetUrl}\" style=\"color:#1d1c84;font-weight:bold;\">Content Queue</a> to approve or reject.\n      </p>\n      ${cardsHtml}\n    </div>\n    <div style=\"background:#fff;border:1px solid #e0e0e0;border-top:none;border-radius:0 0 10px 10px;padding:14px 28px;text-align:center;font-size:12px;color:#999;\">\n      <a href=\"${sheetUrl}\" style=\"color:#1d1c84;font-weight:bold;\">&#8594; Open Content Queue</a> &nbsp;&nbsp;|&nbsp;&nbsp; Carematix Automation System\n    </div>\n  </div>\n</body></html>`;\n\nreturn [{json:{subject:`&#128221; ${rows.length} draft(s) awaiting review`, body:html}}];",
        "mode": "runOnceForAllItems"
      },
