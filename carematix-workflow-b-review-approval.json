        "message": "=Hi,\n\nThe following rows were set to APPROVED but are missing required fields (Reviewer and/or Approval Date). Please fill them in so the workflow can schedule these posts.\n\n{{ $json.invalid.map(r => '\u2022 ' + r['Row ID'] + ' \u2014 ' + (r['Product Education']||r['Theme'])).join('\\n') }}\n\n\ud83d\udc49 https://docs.google.com/spreadsheets/d/1djoz4p-YyJ4Pu43-f9dUjWu4VhY6BCt-uUVMVVdK620/edit\n\n\u2014 Carematix Automation",
        "options": {}
      },
